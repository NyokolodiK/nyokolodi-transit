# ── Resend (email notifications) ──────────────────────────
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender address (must be on a domain verified in Resend)
# e.g. bookings@nyokolodi-transit.co.za
BOOKINGS_FROM_EMAIL="Nyokolodi Transit <bookings@nyokolodi-transit.co.za>"

# Where booking / quote / contact notifications are delivered.
# Comma-separate multiple addresses.
NOTIFICATIONS_EMAIL=info@nyokolodi-transit.co.za

# ── Google Gemini (build-time route content, optional) ────
# Free API key: https://aistudio.google.com/app/apikey
# Used only by `npm run generate:routes`. Not needed at runtime.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Google Maps Platform (auto distance + address lookup, optional) ──
# Enable "Routes API" AND "Places API (New)" in Google Cloud, then create
# an API key: https://console.cloud.google.com/google/maps-apis/credentials
# Requires a billing account; the first 10,000 calls per SKU per month are free.
# When unset, the booking form falls back to plain address + manual distance.
GOOGLE_MAPS_API_KEY=
