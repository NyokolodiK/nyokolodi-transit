{
  "name": "nyokolodi-transit",
  "private": true,
  "version": "0.1.0",
  "description": "Nyokolodi Transit — AI-powered transport booking platform for South Africa.",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,mjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,mjs,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nyokolodi/config": "workspace:*",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
